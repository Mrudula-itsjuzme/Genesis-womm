# Copy to .env locally. Never commit real credentials.
# Placeholders below are development-only values, not secrets.
CAMPUS_TIMEZONE=Asia/Kolkata
CORE_API_PORT=8000
AGENT_API_PORT=8001
RAG_API_PORT=8002
DATABASE_URL=postgresql+psycopg://campuscue:campuscue@postgres:5432/campuscue
# groq = the real model (set GROQ_API_KEY); fake = deterministic and offline.
AGENT_MODEL_PROVIDER=fake
# With fake, true turns on the scripted demo planner (no network, no paid API).
AGENT_DEMO_MODE=false
GROQ_API_KEY=
RAG_EMBEDDING_PROVIDER=local
RAG_SPARSE_PROVIDER=splade
LOG_LEVEL=INFO

# --- Shared by Core API and Agent API ---
# local | test | demo. Seeds and demo-login refuse any other value.
APP_ENV=local
# Required outside APP_ENV=local; sent as X-Internal-Key on service-to-service calls.
INTERNAL_API_KEY=local-only-internal-key-not-a-secret
CORE_API_URL=http://core-api:8000
AGENT_API_URL=http://agent-api:8001
RAG_API_URL=http://rag-api:8002

# --- Core API only (the Agent never holds these) ---
# Distinct keys; 32+ characters; rejected in demo if they keep the local-only prefix.
SESSION_SIGNING_KEY=local-only-session-key-not-a-secret-0001
DELEGATION_SIGNING_KEY=local-only-delegation-key-not-a-secret-0002
# CampusCue planning rule, not verified institutional policy.
CAMPUS_GAP_MINUTES=120

# --- Postgres container ---
POSTGRES_USER=campuscue
POSTGRES_PASSWORD=campuscue
POSTGRES_DB=campuscue

# --- Local MinIO object storage ---
MINIO_ACCESS_KEY=campuscue_admin
MINIO_SECRET_KEY=campuscue_secret
# Host port for the browser to reach MinIO; download links are signed for it.
MINIO_PORT=9000
