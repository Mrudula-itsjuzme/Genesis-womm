{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CampusCue shared cross-service schemas",
  "description": "Generated by services/core-api/scripts/export_contracts.py. Do not edit by hand.",
  "$defs": {
    "AgentAction": {
      "properties": {
        "action_id": {
          "type": "string",
          "format": "uuid",
          "title": "Action Id"
        },
        "type": {
          "$ref": "#/$defs/AgentActionType"
        },
        "summary": {
          "type": "string",
          "title": "Summary"
        },
        "requires_human_review": {
          "type": "boolean",
          "const": true,
          "title": "Requires Human Review",
          "default": true
        },
        "status": {
          "$ref": "#/$defs/AgentActionStatus"
        },
        "target_event_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Event Id"
        },
        "expected_revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Revision",
          "description": "Event revision seen when the Agent filed the proposal."
        },
        "payload": {
          "additionalProperties": true,
          "type": "object",
          "title": "Payload",
          "description": "Opaque to clients; validated by Core per type."
        },
        "conflicts": {
          "items": {
            "$ref": "#/$defs/Conflict"
          },
          "type": "array",
          "title": "Conflicts",
          "description": "Dry-run result stored when the proposal was filed."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "title": "Created At"
        }
      },
      "type": "object",
      "required": [
        "action_id",
        "type",
        "summary",
        "status",
        "target_event_id",
        "payload",
        "created_at"
      ],
      "title": "AgentAction",
      "description": "A proposal. Nothing has happened until a human confirms it."
    },
    "AgentActionStatus": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "EXECUTED",
        "REJECTED",
        "EXPIRED"
      ],
      "title": "AgentActionStatus"
    },
    "AgentActionType": {
      "type": "string",
      "enum": [
        "CREATE_EVENT_DRAFT",
        "REQUEST_EVENT_CHANGE",
        "RECORD_COMMITMENT",
        "CREATE_FOLLOWUP_DRAFT"
      ],
      "title": "AgentActionType",
      "description": "What the Agent may propose. There is no booking, confirmation or override type."
    },
    "Citation": {
      "properties": {
        "evidence_id": {
          "type": "string",
          "title": "Evidence Id"
        },
        "document_id": {
          "type": "string",
          "title": "Document Id"
        },
        "title": {
          "type": "string",
          "title": "Title"
        },
        "source_url": {
          "type": "string",
          "title": "Source Url"
        },
        "page_start": {
          "type": "integer",
          "title": "Page Start"
        },
        "page_end": {
          "type": "integer",
          "title": "Page End"
        },
        "excerpt": {
          "type": "string",
          "title": "Excerpt"
        },
        "document_version": {
          "type": "string",
          "title": "Document Version"
        }
      },
      "type": "object",
      "required": [
        "evidence_id",
        "document_id",
        "title",
        "source_url",
        "page_start",
        "page_end",
        "excerpt",
        "document_version"
      ],
      "title": "Citation",
      "description": "Copied verbatim from the RAG index. The model never writes these fields."
    },
    "Conflict": {
      "properties": {
        "type": {
          "$ref": "#/$defs/ConflictType"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "constraint": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConflictConstraint"
            },
            {
              "type": "null"
            }
          ],
          "description": "The independent scheduling constraint that was violated."
        },
        "event_ids": {
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "type": "array",
          "maxItems": 2,
          "minItems": 1,
          "title": "Event Ids",
          "description": "The candidate first, then the other event."
        },
        "with_event": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConflictEventSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "start_at": {
          "type": "string",
          "format": "date-time",
          "title": "Start At",
          "description": "Overlaps: start of the shared interval. Campus-gap violations: start of the required buffer, which is the end_at of whichever event starts first."
        },
        "end_at": {
          "type": "string",
          "format": "date-time",
          "title": "End At",
          "description": "Overlaps: end of the shared interval. Campus-gap violations: end of the required buffer (that end_at plus the gap)."
        },
        "message": {
          "type": "string",
          "title": "Message"
        },
        "override_required": {
          "type": "boolean",
          "title": "Override Required"
        }
      },
      "type": "object",
      "required": [
        "type",
        "severity",
        "event_ids",
        "start_at",
        "end_at",
        "message",
        "override_required"
      ],
      "title": "Conflict",
      "description": "One violated constraint. Type and severity are assigned only by the Core engine."
    },
    "ConflictConstraint": {
      "type": "string",
      "enum": [
        "VENUE_OVERLAP",
        "CAMPUS_GAP"
      ],
      "title": "ConflictConstraint",
      "description": "The independent scheduling constraint a conflict violates."
    },
    "ConflictEventSummary": {
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "title": "Id"
        },
        "title": {
          "type": "string",
          "title": "Title"
        },
        "club_id": {
          "type": "string",
          "format": "uuid",
          "title": "Club Id"
        },
        "club_name": {
          "type": "string",
          "title": "Club Name"
        },
        "start_at": {
          "type": "string",
          "format": "date-time",
          "title": "Start At"
        },
        "end_at": {
          "type": "string",
          "format": "date-time",
          "title": "End At"
        },
        "resource_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resource Id"
        },
        "resource_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resource Name"
        },
        "status": {
          "$ref": "#/$defs/EventStatus"
        },
        "audience_tags": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "title": "Audience Tags"
        }
      },
      "type": "object",
      "required": [
        "id",
        "title",
        "club_id",
        "club_name",
        "start_at",
        "end_at",
        "resource_id",
        "resource_name",
        "status",
        "audience_tags"
      ],
      "title": "ConflictEventSummary",
      "description": "The minimal view of the other event in a conflict. Never includes private planning data."
    },
    "ConflictType": {
      "type": "string",
      "enum": [
        "VENUE_OVERLAP",
        "CAMPUS_GAP_VIOLATION",
        "TENTATIVE_OVERLAP",
        "DEPENDENCY_CONFLICT",
        "UNKNOWN_AVAILABILITY"
      ],
      "title": "ConflictType"
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "VALIDATION_ERROR",
        "UNAUTHENTICATED",
        "FORBIDDEN",
        "NOT_FOUND",
        "METHOD_NOT_ALLOWED",
        "CONFLICT_DETECTED",
        "STALE_REVISION",
        "IDEMPOTENCY_MISMATCH",
        "INVALID_TRANSITION",
        "DEPENDENCY_UNAVAILABLE",
        "AGENT_OUTPUT_INVALID",
        "NOT_IMPLEMENTED",
        "INTERNAL_ERROR"
      ],
      "title": "ErrorCode"
    },
    "ErrorEnvelope": {
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string",
          "title": "Message"
        },
        "details": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "array",
          "title": "Details"
        },
        "request_id": {
          "type": "string",
          "title": "Request Id"
        }
      },
      "type": "object",
      "required": [
        "code",
        "message",
        "request_id"
      ],
      "title": "ErrorEnvelope",
      "description": "Every non-2xx response, from every service."
    },
    "EventStatus": {
      "type": "string",
      "enum": [
        "DRAFT",
        "PROPOSED",
        "SUBMITTED",
        "CONFIRMED",
        "COMPLETED",
        "REJECTED",
        "CANCELLED"
      ],
      "title": "EventStatus",
      "description": "Event lifecycle. Only CONFIRMED means an authorized actor verified it with evidence."
    },
    "Severity": {
      "type": "string",
      "enum": [
        "blocking",
        "warning",
        "info"
      ],
      "title": "Severity",
      "description": "Lowercase on the wire, as in contracts/CONTRACTS.md."
    }
  }
}
